# Required Variables
WATCH_FOLDER=/path/to/folder/to/watch
STATE_FILE=/path/to/state.json
LOG_FILE=/path/to/watcher.log
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
CHECK_INTERVAL=30s

# Optional Variables (with defaults)
STABILITY_CHECKS=3
QUIET_HOURS_ENABLED=false
QUIET_HOURS_START=22
QUIET_HOURS_END=8
TIMEZONE=UTC
MIN_FILE_SIZE=0
EXCLUDE_PATTERNS=~private-asp*,sync.ffs_db,System Volume Information,$$Recycle.Bin,RECYCLE?,Recovery,thumbs.db,*.DS_*,*[[]Auto Save[]]*,*.pkf,assets.json

# Web UI (status page)
WEB_UI_ENABLED=true
WEB_UI_PORT=2645
WEB_UI_HOST=0.0.0.0
# The "Scan now" button: how many steady checks a file needs, and how many
# seconds apart they are taken (instead of STABILITY_CHECKS a full CHECK_INTERVAL apart)
MANUAL_STABILITY_CHECKS=1
MANUAL_SETTLE_SECONDS=5

# Status updates to cn4m (the parent system). Empty disables them.
# Leave unset to auto-pick: host.docker.internal inside Docker, localhost otherwise.
STATUS_URL=http://host.docker.internal:2640/suite/status
STATUS_APP_NAME=inbound

# Tell symmetry a file is complete so it links it now instead of on its next
# scan. Empty disables it. Same auto-pick rule as STATUS_URL when unset.
SYMMETRY_RESCAN_URL=http://host.docker.internal:2647/api/rescan
# Only needed if symmetry has WEBHOOK_TOKEN set; must match it
SYMMETRY_RESCAN_TOKEN=
