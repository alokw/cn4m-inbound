# Required Variables
WATCH_FOLDER=/path/to/folder/to/watch
STATE_FILE=/path/to/state.json
LOG_FILE=/path/to/watcher.log
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
CHECK_INTERVAL=30s

# Optional Variables (with defaults)
STABILITY_CHECKS=3
QUIET_HOURS_ENABLED=false
QUIET_HOURS_START=22
QUIET_HOURS_END=8
TIMEZONE=UTC
MIN_FILE_SIZE=0
EXCLUDE_PATTERNS=~private-asp*,sync.ffs_db,System Volume Information,$$Recycle.Bin,RECYCLE?,Recovery,thumbs.db,*.DS_*,*[[]Auto Save[]]*,*.pkf,assets.json

# Web UI (status page)
WEB_UI_ENABLED=true
WEB_UI_PORT=2645
WEB_UI_HOST=0.0.0.0

# Status updates to cn4m (the parent system). Empty disables them.
# Inside Docker use http://host.docker.internal:2640/suite/status
STATUS_URL=http://localhost:2640/suite/status
STATUS_APP_NAME=inbound
